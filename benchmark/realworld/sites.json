            { "op": "act", "target": { "tag": "a", "name": "next" }, "expect": { "status": "ok", "urlContains": "page-2" } }
          ]
        }
      ]
    },
    {
      "id": "httpbin-form",
      "url": "https://httpbin.org/forms/post",
      "scenarios": [
        {
          "name": "fill and submit form",
          "steps": [
            { "op": "act", "target": { "tag": "input", "nameContains": "Customer name" }, "payload": { "value": "ahttp" }, "expect": { "status": "ok" } },
            { "op": "act", "target": { "tag": "input", "nameContains": "Telephone" }, "payload": { "value": "12345" }, "expect": { "status": "ok" } },
            { "op": "act", "target": { "tag": "input", "nameContains": "E-mail address" }, "payload": { "value": "ahttp@example.com" }, "expect": { "status": "ok" } },
            { "op": "act", "target": { "tag": "input", "type": "radio", "index": 1 }, "payload": { "checked": true }, "expect": { "status": "ok" } },
            { "op": "act", "target": { "tag": "input", "type": "checkbox", "index": 0 }, "payload": { "checked": true }, "expect": { "status": "ok" } },
            { "op": "act", "target": { "role": "button", "name": "Submit order" }, "payload": { "timeout": 15000 }, "expect": { "status": "ok", "text": ["ahttp@example.com"] } }
          ]
        }
      ]
    },
