{
  "id": "disabled-twin-and-active-twin",
  "html": "fixtures/run-original.html",
  "url": "https://corpus.test/disabled-twin-and-active-twin",
  "notes": "PINNED CURRENT BEHAVIOUR, not an endorsement: the original Run is replaced by [disabled Run][active Run]. Disabled candidates are filtered before scoring, so the active twin is clicked. Single disabled replacement is covered by disabled-not-matched-after-rerender",
  "steps": [
    {
      "action": "snapshot",
      "expectIds": [
        "a1"
      ]
    },
    {
      "action": "rerender",
      "selector": "#app",
      "html": "<button disabled onclick=\"window.__mark('disabled')\">Run</button><button onclick=\"window.__mark('active')\">Run</button>"
    },
    {
      "action": "click",
      "expectedId": "a1",
      "targetHint": "Run button",
      "expectEffect": {
        "pageText": {
          "selector": "#out",
          "equals": "active"
        }
      }
    }
  ]
}
