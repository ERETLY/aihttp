{
  "id": "disabled-twin-and-active-twin",
  "html": "fixtures/run-original.html",
  "url": "https://corpus.test/disabled-twin-and-active-twin",
  "notes": "the original Run is replaced by [disabled Run][active Run]; with no anchor separating them the reply must be ambiguous",
  "steps": [
    {
      "action": "snapshot",
      "expectIds": [
        "a1"
      ]
    },
    {
      "action": "rerender",
      "selector": "#app",
      "html": "<button disabled onclick=\"window.__mark('disabled')\">Run</button><button onclick=\"window.__mark('active')\">Run</button>"
    },
    {
      "action": "click",
      "expectedId": "a1",
      "targetHint": "Run button",
      "expectStatus": "ambiguous",
      "expectEffect": {
        "candidates": 2,
        "noMutation": true,
        "pageText": {
          "selector": "#out",
          "equals": "idle"
        }
      }
    }
  ]
}
