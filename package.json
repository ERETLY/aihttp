{
  "name": "aihttp",
  "version": "1.0.0",
  "description": "AI HTTP: a compact, executable page graph for agents. Zero-dependency browser file, CLI, HTTP server and MCP server.",
  "main": "aihttp.js",
  "browser": "aihttp.js",
  "types": "aihttp.d.ts",
  "type": "commonjs",
  "author": "ERETLY",
  "homepage": "https://github.com/ERETLY/aiweb",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ERETLY/aiweb.git"
  },
  "bugs": {
    "url": "https://github.com/ERETLY/aiweb/issues"
  },
  "exports": {
    ".": {
      "types": "./aihttp.d.ts",
      "import": "./aihttp.js",
      "require": "./aihttp.js",
      "default": "./aihttp.js"
    },
    "./min": {
      "types": "./aihttp.d.ts",
      "default": "./aihttp.min.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "aihttp": "./bin/aihttp-cli.js",
    "aihttp-mcp": "./bin/aihttp-mcp.js",
    "aihttp-serve": "./bin/aihttp-serve.js",
    "ahttp": "./bin/aihttp-cli.js",
    "ahttp-mcp": "./bin/aihttp-mcp.js"
  },
  "files": [
    "aihttp.js",
    "aihttp.min.js",
    "aihttp.d.ts",
    "bin/",
    "lib/",
    "self/",
    "docs/",
    "llms.txt",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-min.js && node scripts/build-self.js",
    "build:self": "node scripts/build-self.js",
    "bump": "node scripts/bump-version.js",
    "bench": "node benchmark/run.js",
    "bench:self": "node benchmark/self.js",
    "bench:time": "node benchmark/time.js",
    "bench:pinned": "node benchmark/fetch-pinned.js",
    "bench:render": "node scripts/render-bench.js --write",
    "test": "node --test",
    "test:bench": "node benchmark/run.js",
    "test:corpus": "node corpus/runner.js",
    "test:realworld": "node benchmark/realworld/run.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "pack:check": "npm pack --dry-run",
    "smoke": "node scripts/smoke-runtime.js",
    "start": "node bin/aihttp-cli.js",
    "bench:web": "node benchmark/web-matrix.js",
    "bench:web:summary": "node benchmark/coverage-summary.js"
  },
  "keywords": [
    "aihttp",
    "ai-agents",
    "mcp",
    "mcp-server",
    "llm",
    "llms-txt",
    "browser-automation",
    "web-scraping",
    "tool-calling",
    "agentic-web",
    "owner-mode",
    "access-control",
    "server-auth",
    "dom",
    "accessibility",
    "userscript",
    "tampermonkey",
    "no-server",
    "self-hosted",
    "javascript"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "playwright": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@mozilla/readability": "^0.6.0",
    "dom-accessibility-api": "^0.7.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "gpt-tokenizer": "^4.1.0",
    "jsdom": "^26.1.0",
    "linkedom": "^0.18.14",
    "playwright": "^1.64.1",
    "terser": "^5.51.2",
    "turndown": "^7.2.4",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "license": "MIT"
}
